{
  "name": "neogen-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run check:catalog && npm run check:media && npm run check:commerce && npm run check:checkout && npm run build && npm run check:output",
    "check:catalog": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-catalog.mjs",
    "check:commerce": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-commerce.mjs",
    "check:media": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-media.mjs",
    "check:output": "node scripts/check-output.mjs",
    "check:checkout": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-checkout.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "NEOGEN — premium science-led ecommerce MVP for Mexico."
}
