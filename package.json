{
  "name": "neogen-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run check:catalog && npm run check:media && npm run check:commerce && npm run check:checkout && npm run check:payments && npm run check:quality && npm run check:content && npm run check:atlas && npm run build && npm run check:output",
    "check:catalog": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-catalog.mjs",
    "check:commerce": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-commerce.mjs",
    "check:media": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-media.mjs",
    "check:output": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-output.mjs",
    "check:checkout": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-checkout.mjs",
    "check:payments": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-payments.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "brand": "node scripts/prepare-brand.mjs",
    "check:quality": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-quality.mjs",
    "check:content": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-content.mjs",
    "check:atlas": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/check-atlas.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "NEOGEN — premium science-led ecommerce MVP for Mexico."
}
