# NEOGEN — environment variables.
#
# Copy to `.env.local` for local work (git-ignored) and fill in real values.
# Never commit a filled-in copy. Full guide: docs/PAYMENTS.md.

# --- Site -------------------------------------------------------------------

# Canonical origin, used for metadata, the sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Commerce ------------------------------------------------------------------

# Business switch: may customers use the bag and checkout at all?
# "true" to enable. Anything else (or unset) keeps purchasing off.
# Inlined at BUILD time — rebuild after changing it.
NEXT_PUBLIC_COMMERCE_ENABLED=false

# --- Mercado Pago (Checkout API via Orders API) ---------------------------------
#
# All four are required; with any one missing, payment stays unavailable and
# the checkout says so. Values come from Mercado Pago → Your integrations →
# your application → Test credentials (or Production credentials).

# "test" or "live". Explicit on purpose: test and production access tokens
# share the APP_USR- prefix, so the mode is never guessed from a credential.
MERCADOPAGO_MODE=test

# SECRET. Server only. Creates and reads orders.
MERCADOPAGO_ACCESS_TOKEN=

# Publishable. Handed to Mercado Pago's card fields at render time.
MERCADOPAGO_PUBLIC_KEY=

# SECRET. Your integrations → Webhooks → Configure notifications → secret key.
# Verifies every webhook signature.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Storage ------------------------------------------------------------------------
#
# Postgres connection string (Neon recommended: docs/PERSISTENCE_RECOMMENDATION.md).
# Unset → in-memory storage, which is acceptable for local TEST mode only.
# LIVE mode refuses to take payments without it.
# Apply the schema once per database: `npm run db:migrate`.
DATABASE_URL=

# --- Operations console (/ops) -------------------------------------------------------
#
# Off unless BOTH are set: every /ops route is a 404. Full guide: docs/OPERATIONS.md.

# One `name:salt:hash` entry per person, comma-separated. Generate each with
#   npm run ops:account -- <name>
# (the password is typed at a prompt, never put on the command line).
OPS_ACCOUNTS=

# SECRET, at least 32 random characters. Signs the console session cookie.
# Rotating it signs everyone out.
OPS_SESSION_SECRET=

# Refunds sent to the payment processor with LIVE credentials are refused
# unless this is exactly "enabled". Test-mode refunds are always allowed.
OPS_LIVE_REFUNDS=

# Simple Effects (the console's content editor) writes src/content/effects/
# simple-effects.json by default. Point it elsewhere to test without touching
# the real file. Leave empty in normal use.
NEOGEN_EFFECTS_FILE=

# --- Customer order-status links -----------------------------------------------------
#
# SECRET, at least 32 random characters. Signs the "view your order" link in
# customer emails, and the cookies that let a browser open its own orders or
# ones it looked up at /rastrear. REQUIRED in any production build: without it
# payment stays off (`order_access_unconfigured`). Locally, unset → a
# per-process key is used and no email link is issued. Rotating it invalidates
# every link sent and every order cookie.
ORDER_ACCESS_SECRET=

# --- Transactional email (Resend) ---------------------------------------------------
#
# Nothing is sent unless RESEND_API_KEY, EMAIL_FROM and EMAIL_SENDING=enabled are
# all set. Turn EMAIL_SENDING on only after the sending domain is verified in
# Resend. Full guide: docs/OPERATIONS.md section 7.

# SECRET. A Resend API key with sending access.
RESEND_API_KEY=
# "NEOGEN <address@your-verified-domain>"
EMAIL_FROM=
# Exactly "enabled" to send. Anything else: messages stay pending.
EMAIL_SENDING=
# Operations inbox(es) for "new paid order" and "dispute", comma-separated.
EMAIL_OPERATIONS_TO=
# Optional. Where customer replies go.
EMAIL_REPLY_TO=
# TESTING ONLY (Preview): every email goes here instead. Refused on Production.
EMAIL_REDIRECT_TO=

# --- Scheduled payment reconcile ------------------------------------------------------
#
# SECRET, at least 32 random characters. When this exists Vercel sends it as
# `Authorization: Bearer <value>` on each run of the cron in vercel.json, which
# asks the payment processor about payments still in flight. Without it the
# route answers 503 and nothing runs. Set it on PRODUCTION: Vercel runs scheduled
# jobs on the production deployment only.
CRON_SECRET=

# --- NEOGEN Atlas (V2, frozen) ------------------------------------------------------
# ANTHROPIC_API_KEY=
